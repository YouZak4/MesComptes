# Modèle de configuration : copiez ce fichier en application.properties (ignoré par Git) et remplacez les A_REMPLACER.
# Nom de l'application
spring.application.name=backend
server.servlet.context-path=/api
# Serveur
server.port=8085
# Base de données PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/mescomptes
spring.datasource.username=A_REMPLACER
spring.datasource.password=A_REMPLACER
# JPA / Hibernate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.open-in-view=false
# Flyway : passe avant Hibernate. Une base créée avant Flyway démarre à la version 0, pour que V1 s'y applique
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0
# JWT
# Chaîne aléatoire d'au moins 32 caractères (utilisée telle quelle comme clé HMAC)
jwt.secret=A_REMPLACER
# 24 heures
jwt.expiration=86400000
# mail
spring.mail.host=localhost
spring.mail.port=25
app.mail.from=no-reply@mescomptes.local
app.verification.expiration-minutes=15
app.verification.max-tentatives=5
app.verification.delai-renvoi-secondes=60
app.verification.duree-vie-heures=24
# toutes les heures, à la minute 0 (secondes minutes heures jour mois jour-semaine)
app.verification.nettoyage-cron=0 0 * * * *
# récurrences : génération des opérations chaque nuit à 0h05 (secondes minutes heures jour mois jour-semaine)
app.recurrences.generation-cron=0 5 0 * * *
